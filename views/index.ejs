<%- include('layout/header', { pageTitle: 'Home' }) %>

<!-- Hero Section -->
<section class="relative overflow-hidden">

  <!-- Background grid pattern -->
  <div class="hero-grid-bg absolute inset-0 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Copy -->
      <div class="animate-fadeInUp">

        <div class="inline-flex items-center gap-2 bg-vault-accentLight text-vault-accent px-3 py-1.5 rounded-full text-xs font-mono font-medium mb-6 border border-indigo-200">
          <span class="w-1.5 h-1.5 bg-vault-accent rounded-full animate-pulse"></span>
          Inventory · Simplified
        </div>

        <h1 class="font-display font-800 text-5xl sm:text-6xl leading-[1.05] tracking-tight text-vault-text mb-6">
          All your product
          <span class="text-vault-accent relative">
            variants
            <svg class="absolute -bottom-1 left-0 w-full" viewBox="0 0 200 8" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
              <path d="M1 5.5 C40 1.5 80 7.5 120 4.5 C160 1.5 180 6 199 3.5" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.4"/>
            </svg>
          </span>
          <br/>in one vault.
        </h1>

        <p class="text-vault-muted text-lg leading-relaxed mb-10 max-w-lg">
          Stop wrestling with spreadsheets. VariantVault lets small sellers create,
          track, and update product variants — sizes, quantities, everything —
          from a clean, fast dashboard.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          <a href="/add" class="btn-primary btn-lg group">
            <svg class="w-5 h-5 transition-transform group-hover:rotate-90 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add a Product
          </a>
          <a href="/products" class="btn-secondary btn-lg group">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            View Products
          </a>
        </div>

        <!-- Stats row -->
        <div class="flex gap-8 mt-12 pt-8 border-t border-vault-border">
          <div>
            <div class="font-mono text-2xl font-medium text-vault-accent">200</div>
            <div class="text-xs text-gray-400 mt-0.5">Size options (0.5 → 100)</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-medium text-vault-accent">∞</div>
            <div class="text-xs text-gray-400 mt-0.5">Products & variants</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-medium text-vault-accent">0</div>
            <div class="text-xs text-gray-400 mt-0.5">Spreadsheets needed</div>
          </div>
        </div>
      </div>

      <!-- Right: Visual dashboard mockup -->
      <div class="hidden lg:block animate-fadeInRight">
        <div class="vault-card p-0 overflow-hidden shadow-2xl">

          <!-- Mock browser bar -->
          <div class="bg-gray-50 border-b border-vault-border px-4 py-3 flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
            <div class="flex-1 mx-4 bg-white border border-vault-border rounded px-3 py-1 text-xs font-mono text-gray-400">
              localhost:3000/products
            </div>
          </div>

          <!-- Mock product cards -->
          <div class="p-6 bg-vault-bg">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display font-700 text-sm text-vault-text">Your Products</h3>
              <span class="font-mono text-xs text-vault-accent bg-vault-accentLight px-2 py-0.5 rounded-full">3 items</span>
            </div>

            <div class="space-y-3">
              <!-- Mock card 1 -->
              <div class="vault-card p-4 flex items-center justify-between">
                <div>
                  <div class="font-display font-600 text-sm text-vault-text">Air Max 90 Retro</div>
                  <div class="font-mono text-xs text-gray-400 mt-0.5">8 variants · 124 units</div>
                </div>
                <div class="flex gap-2">
                  <div class="w-7 h-7 rounded-lg bg-vault-accentLight flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-vault-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div class="w-7 h-7 rounded-lg bg-gray-100 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Mock card 2 -->
              <div class="vault-card p-4 flex items-center justify-between border-l-4 border-vault-accent">
                <div>
                  <div class="font-display font-600 text-sm text-vault-text">Jordan 1 High OG</div>
                  <div class="font-mono text-xs text-gray-400 mt-0.5">5 variants · 60 units</div>
                </div>
                <div class="flex gap-2">
                  <div class="w-7 h-7 rounded-lg bg-vault-accentLight flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-vault-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div class="w-7 h-7 rounded-lg bg-gray-100 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Mock card 3 — faded -->
              <div class="vault-card p-4 flex items-center justify-between opacity-50">
                <div>
                  <div class="font-display font-600 text-sm text-vault-text">New Balance 550</div>
                  <div class="font-mono text-xs text-gray-400 mt-0.5">12 variants · 200 units</div>
                </div>
                <div class="flex gap-2">
                  <div class="w-7 h-7 rounded-lg bg-vault-accentLight flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-vault-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-20 bg-white border-t border-vault-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <h2 class="font-display font-700 text-3xl text-vault-text mb-3">Everything you need to manage variants</h2>
      <p class="text-vault-muted max-w-xl mx-auto">Built lean. No bloat, no subscriptions, no learning curve.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Dynamic Variant Rows</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Add as many size–quantity pairs as you need with one click. Searchable dropdown from 0.5 to 100.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Live Stock Totals</h3>
        <p class="text-sm text-gray-500 leading-relaxed">See total stock per product at a glance. No manual counting, no formula errors.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Edit Anytime</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Update names, add or remove variant rows, and adjust quantities whenever stock changes.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Smart Search</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Filter your product list instantly by name. Find what you need without scrolling through everything.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Persistent Storage</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Everything saved to MySQL. Data stays intact between sessions, no re-entry ever needed.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="font-display font-600 text-base text-vault-text mb-2">Fast & Local</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Runs entirely on your machine. No internet required after setup, no cloud dependencies.</p>
      </div>

    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="py-16 bg-vault-accent">
  <div class="max-w-3xl mx-auto px-4 text-center">
    <h2 class="font-display font-700 text-3xl text-white mb-4">Ready to vault your inventory?</h2>
    <p class="text-indigo-200 mb-8 text-lg">Add your first product in under a minute.</p>
    <a href="/add" class="inline-flex items-center gap-2 bg-white text-vault-accent font-display font-600 px-8 py-3.5 rounded-xl hover:bg-indigo-50 transition-colors duration-200 shadow-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Get Started Free
    </a>
  </div>
</section>

<%- include('layout/footer') %>
