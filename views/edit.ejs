<%- include('layout/header', { pageTitle: 'Edit ' + product.name }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm font-mono text-gray-400 mb-6">
    <a href="/products" class="hover:text-vault-accent transition-colors">Products</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <a href="/product/<%= product.id %>" class="hover:text-vault-accent transition-colors"><%= product.name %></a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <span class="text-vault-text">Edit</span>
  </div>

  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="font-display font-700 text-3xl text-vault-text">Edit Product</h1>
    <p class="text-vault-muted mt-1.5">Update the product name or modify its variant inventory.</p>
  </div>

  <!-- Error message -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-error mb-6" role="alert">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <%= error %>
    </div>
  <% } %>

  <!-- Form Card -->
  <div class="vault-card p-8">
    <form action="/edit/<%= product.id %>" method="POST" id="editProductForm" novalidate>

      <!-- Product Name -->
      <div class="mb-8">
        <label for="productName" class="form-label">Product Name <span class="text-red-400">*</span></label>
        <input
          type="text"
          id="productName"
          name="productName"
          class="form-input"
          value="<%= product.name %>"
          required
          autocomplete="off"
          maxlength="255"
        />
      </div>

      <!-- Variants Section -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <label class="form-label mb-0">Variants <span class="text-red-400">*</span></label>
            <p class="form-hint mt-0.5">Existing variants are pre-filled. You can add or remove rows.</p>
          </div>
          <button type="button" id="addRowBtn" class="btn-primary btn-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Variant
          </button>
        </div>

        <!-- Column labels -->
        <div class="grid grid-cols-[1fr_140px_44px] gap-3 mb-2 px-1">
          <div class="text-xs font-mono font-medium text-gray-400 uppercase tracking-wider">Size</div>
          <div class="text-xs font-mono font-medium text-gray-400 uppercase tracking-wider">Quantity</div>
          <div></div>
        </div>

        <!-- Variant rows container -->
        <div id="variantContainer" class="space-y-2.5">
          <!-- Rows injected by JS -->
        </div>

        <!-- Empty state -->
        <div id="emptyVariantHint" class="hidden text-center py-8 border-2 border-dashed border-vault-border rounded-xl mt-2">
          <p class="text-sm text-gray-400">No variants — click <strong class="text-vault-text">Add Variant</strong> to add some</p>
        </div>
      </div>

      <!-- Counters -->
      <div class="flex items-center justify-between py-3 border-t border-vault-border mb-6">
        <span class="font-mono text-sm text-gray-400">
          <span id="variantCount">0</span> variant(s)
        </span>
        <span class="font-mono text-sm text-gray-400">
          Total units: <span id="totalUnits" class="text-vault-accent font-medium">0</span>
        </span>
      </div>

      <!-- Submit -->
      <div class="flex gap-3">
        <button type="submit" class="btn-primary btn-lg flex-1 justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Save Changes
        </button>
        <a href="/product/<%= product.id %>" class="btn-secondary btn-lg">Cancel</a>
      </div>

    </form>
  </div>
</div>

<!-- Variant Row Template -->
<template id="variantRowTemplate">
  <div class="variant-row grid grid-cols-[1fr_140px_44px] gap-3 items-start animate-fadeInUp">
    <div class="size-dropdown-wrapper relative">
      <input type="text" class="size-search form-input" placeholder="Search size (e.g. 9.5)" autocomplete="off" />
      <input type="hidden" name="sizes[]" class="size-value" />
      <div class="size-dropdown absolute left-0 right-0 top-full mt-1 bg-white border border-vault-border rounded-xl shadow-lg z-40 max-h-48 overflow-y-auto hidden"></div>
      <p class="size-error text-xs text-red-500 mt-1 hidden">Please select a valid size.</p>
    </div>
    <div>
      <input type="number" name="quantities[]" class="qty-input form-input" placeholder="Qty" min="1" step="1" />
      <p class="qty-error text-xs text-red-500 mt-1 hidden">Min 1.</p>
    </div>
    <button type="button" class="remove-row-btn h-[42px] w-[44px] flex items-center justify-center rounded-xl border border-vault-border text-gray-400 hover:bg-vault-dangerLight hover:border-red-300 hover:text-vault-danger transition-all duration-150" title="Remove row">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
</template>

<!-- Pass existing variants to JS -->
<script>
  const existingVariants = <%- JSON.stringify(variants.map(v => ({ size: v.size, quantity: v.quantity }))) %>;

  document.addEventListener('DOMContentLoaded', () => {
    initVariantForm('editProductForm');

    // Populate existing variants
    existingVariants.forEach(v => {
      addVariantRow(v.size, v.quantity);
    });

    // If none, add a blank row
    if (existingVariants.length === 0) addVariantRow();

    updateCounters();
  });
</script>

<%- include('layout/footer') %>
