<%- include('layout/header', { pageTitle: product.name }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 text-sm font-mono text-gray-400 mb-6">
    <a href="/products" class="hover:text-vault-accent transition-colors">Products</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
    <span class="text-vault-text"><%= product.name %></span>
  </div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 bg-vault-accentLight rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-vault-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <span class="font-mono text-xs text-gray-400">#<%= String(product.id).padStart(4, '0') %></span>
      </div>
      <h1 class="font-display font-700 text-3xl text-vault-text"><%= product.name %></h1>
      <p class="text-gray-400 font-mono text-sm mt-1">
        Added <%= new Date(product.created_at).toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }) %>
      </p>
    </div>
    <a href="/edit/<%= product.id %>" class="btn-primary self-start">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      Edit Product
    </a>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="vault-card p-5 text-center">
      <div class="font-mono text-2xl font-medium text-vault-accent mb-1"><%= variants.length %></div>
      <div class="text-xs text-gray-400">Variants</div>
    </div>
    <div class="vault-card p-5 text-center">
      <div class="font-mono text-2xl font-medium text-vault-text mb-1"><%= totalStock %></div>
      <div class="text-xs text-gray-400">Total Units</div>
    </div>
    <div class="vault-card p-5 text-center">
      <%
        const maxVariant = variants.reduce((m, v) => v.quantity > m.quantity ? v : m, variants[0] || {quantity: 0, size: '—'});
      %>
      <div class="font-mono text-2xl font-medium text-vault-text mb-1"><%= maxVariant.size || '—' %></div>
      <div class="text-xs text-gray-400">Top Size</div>
    </div>
  </div>

  <!-- Variants Table -->
  <div class="vault-card overflow-hidden">
    <div class="px-6 py-4 border-b border-vault-border flex items-center justify-between">
      <h2 class="font-display font-600 text-base text-vault-text">Variant Inventory</h2>
      <span class="font-mono text-xs text-vault-accent bg-vault-accentLight px-2.5 py-1 rounded-full">
        <%= variants.length %> size<%= variants.length !== 1 ? 's' : '' %>
      </span>
    </div>

    <% if (variants.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-vault-border">
              <th class="text-left px-6 py-3 text-xs font-mono font-medium text-gray-400 uppercase tracking-wider w-8">#</th>
              <th class="text-left px-6 py-3 text-xs font-mono font-medium text-gray-400 uppercase tracking-wider">Size</th>
              <th class="text-right px-6 py-3 text-xs font-mono font-medium text-gray-400 uppercase tracking-wider">Quantity</th>
              <th class="text-right px-6 py-3 text-xs font-mono font-medium text-gray-400 uppercase tracking-wider">Stock %</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-vault-border">
            <% variants.forEach((variant, idx) => {
                const pct = totalStock > 0 ? Math.round((variant.quantity / totalStock) * 100) : 0;
            %>
            <tr class="table-row-hover">
              <td class="px-6 py-4 font-mono text-xs text-gray-300"><%= idx + 1 %></td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <span class="w-9 h-9 rounded-xl bg-vault-accentLight flex items-center justify-center font-mono font-medium text-vault-accent text-sm flex-shrink-0">
                    <%= Number.isInteger(variant.size) ? variant.size : variant.size %>
                  </span>
                  <div>
                    <div class="font-mono font-medium text-sm text-vault-text">Size <%= variant.size %></div>
                    <div class="w-24 h-1 bg-gray-100 rounded-full mt-1">
                      <div class="h-1 bg-vault-accent rounded-full transition-all duration-500"
                           style="width: <%= pct %>%"></div>
                    </div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <span class="font-mono font-medium text-vault-text text-sm"><%= variant.quantity %></span>
                <span class="font-mono text-xs text-gray-400 ml-1">units</span>
              </td>
              <td class="px-6 py-4 text-right">
                <span class="font-mono text-xs px-2 py-0.5 rounded-full
                  <%= pct >= 20 ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700' %>">
                  <%= pct %>%
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <!-- Totals row -->
          <tfoot>
            <tr class="bg-gray-50 border-t-2 border-vault-border">
              <td class="px-6 py-3" colspan="2">
                <span class="font-display font-600 text-sm text-vault-text">Total Stock</span>
              </td>
              <td class="px-6 py-3 text-right">
                <span class="font-mono font-600 text-vault-accent"><%= totalStock %></span>
                <span class="font-mono text-xs text-gray-400 ml-1">units</span>
              </td>
              <td class="px-6 py-3 text-right">
                <span class="font-mono text-xs text-gray-400">100%</span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-12 text-gray-400">
        <p class="font-mono text-sm">No variants found for this product.</p>
        <a href="/edit/<%= product.id %>" class="btn-primary mt-4 inline-flex">Add Variants</a>
      </div>
    <% } %>
  </div>

  <!-- Bottom Actions -->
  <div class="flex items-center justify-between mt-6">
    <a href="/products" class="btn-secondary">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      All Products
    </a>
    <form action="/delete/<%= product.id %>" method="POST" class="delete-form" data-name="<%= product.name %>">
      <button type="submit" class="btn-danger-outline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Delete Product
      </button>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('.delete-form').forEach(form => {
    form.addEventListener('submit', (e) => {
      if (!confirm(`Delete "${form.dataset.name}"?\n\nThis action cannot be undone.`)) {
        e.preventDefault();
      }
    });
  });
</script>

<%- include('layout/footer') %>
